# pflanzenlabor default apache configuration
# change ___path___ to the location of the project

Define PROJECT_PATH __path__

<VirtualHost *:80>
    ServerName localhost
    Alias /pflanzenlabor "${PROJECT_PATH}"

    <Directory "${PROJECT_PATH}">
        AllowOverride All
        Options FollowSymLinks
        Require all granted
    </Directory>

    <Directory "${PROJECT_PATH}/server">
        Require all denied
    </Directory>
</VirtualHost>
